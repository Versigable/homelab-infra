{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Receive-only agent inboxes. Email Routing rules on agents.ninjaprivacy.org
	// ("send to Worker agent-mail", one literal rule per agent) deliver here.
	"name": "agent-mail",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"account_id": "fb863170325a3ed036eed9f15138743c",
	"send_metrics": false, // no Wrangler usage telemetry from this project

	// Read endpoint: agent-mail.<account workers.dev subdomain>.workers.dev. The full
	// URL is deliberately not written in this repo (it is mirrored publicly, and the
	// Free plan's 100k requests/day is account-wide). Agents keep it in local config.
	// Version preview URLs stay off so no second, unreviewed hostname exists.
	"workers_dev": true,
	"preview_urls": false,

	"kv_namespaces": [
		// Stored mail, 30-day TTL per key. Namespace made by MetaVersig 2026-11-21.
		{ "binding": "MAIL", "id": "08225a10f14d420c8066fa21ba8e670a" }
	],

	"vars": {
		"MAIL_DOMAIN": "agents.ninjaprivacy.org",
		// Local-parts this Worker accepts. Each one also needs its own Email Routing
		// rule (catch-all rules are apex-only) and a token hash to read with.
		"AGENTS": "mv-agent,esquie,drclawbotnik,merquery",
		"RETENTION_DAYS": "30"
	},
	// Secret, set with `wrangler secret put AGENT_TOKEN_HASHES` (never committed):
	//   {"mv-agent":"<sha256 hex of token>", ...}

	"observability": {
		"enabled": true,
		// Our own console lines carry metadata only. Invocation logs would also
		// record request details, so they stay off.
		"logs": { "invocation_logs": false }
	}
}
