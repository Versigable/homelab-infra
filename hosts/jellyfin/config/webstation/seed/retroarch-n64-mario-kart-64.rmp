# Mario Kart 64 on an Xbox pad, players 1-4. Installed under each Mario Kart 64 dump's
# name in config/remaps/Mupen64Plus-Next/ (50-seed-emulators). RetroArch loads only the
# most specific remap file, so this repeats retroarch-n64.rmp's lines (Xbox B -> N64 B,
# RT -> N64 R) and adds two of its own (RetroPad ids as in retroarch-n64.rmp):
# - btn_l -> l2: LB is N64 Z (item), like LT. Items on the left, hop/drift on RT/RB,
#   as in Mario Kart 8.
# - btn_select -> l: Back is N64 L (music volume), which LB no longer reaches.
input_player1_btn_a = "1"
input_player1_btn_r2 = "11"
input_player1_btn_l = "12"
input_player1_btn_select = "10"
input_player2_btn_a = "1"
input_player2_btn_r2 = "11"
input_player2_btn_l = "12"
input_player2_btn_select = "10"
input_player3_btn_a = "1"
input_player3_btn_r2 = "11"
input_player3_btn_l = "12"
input_player3_btn_select = "10"
input_player4_btn_a = "1"
input_player4_btn_r2 = "11"
input_player4_btn_l = "12"
input_player4_btn_select = "10"
