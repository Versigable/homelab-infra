#!/usr/bin/with-contenv bash
# Runs as root on every container start (LinuxServer custom-cont-init.d).
# Seeds what the romm-broker expects in /config but never provides itself.
# Every step only fills a gap, so files the emulators have since written stay.

BIOS=/romm/library/bios

# Directories are made as abc: on a fresh /config, a root-owned parent would stop
# the emulator from writing its own data dir.
mkdir_abc() { s6-setuidgid abc mkdir -p "$1"; }

seed() { # seed <src> <dest>: copy when the destination is missing
  [[ -e "$2" ]] && return 0
  if [[ ! -f "$1" ]]; then
    echo "[seed-emulators] missing source: $1"
    return 0
  fi
  mkdir_abc "$(dirname "$2")"
  install -m 0644 -o abc -g abc "$1" "$2" && echo "[seed-emulators] seeded $2"
}

# set_defaults <file> <section> <key> <value> [<section> <key> <value> ...]
# Adds each key to its [section] of an INI or TOML file only when the file doesn't
# set it yet, so a value changed later in the emulator's own menus stays. A .toml
# result must parse (tomllib) with every key in its own table, or the file is left
# as it was. The file keeps its mode (on config-2/3 that sets the ACL mask).
set_defaults() {
  mkdir_abc "$(dirname "$1")"
  python3 - "$@" <<'PY' || echo "[seed-emulators] could not update $1; left as it was"
import os, re, sys, tempfile
path, args = sys.argv[1], sys.argv[2:]
toml = path.endswith(".toml")
header = re.compile(r"\s*\[([^\[\]]+)\]\s*(#.*)?$")
boundary = re.compile(r"\s*\[\[?[^\[\]]+\]\]?\s*(#.*)?$")  # a section also ends at a TOML [[table]]

def lookup(tree, section, key):
    node = tree
    for part in section.split(".") + [key]:
        node = node.get(part) if isinstance(node, dict) else None
    return node

tmp = None
try:
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        lines = []
    if toml:
        import tomllib
        have = tomllib.loads("\n".join(lines))
    added = []
    for i in range(0, len(args), 3):
        section, key, value = args[i:i + 3]
        if toml and lookup(have, section, key) is not None:
            continue
        start = next((n for n, l in enumerate(lines)
                      if (m := header.match(l)) and m.group(1).strip() == section), None)
        if start is None:
            if lines and lines[-1].strip():
                lines.append("")
            lines += [f"[{section}]", f"{key} = {value}"]
        else:
            end = next((n for n in range(start + 1, len(lines)) if boundary.match(lines[n])), len(lines))
            if any(re.match(rf"\s*{re.escape(key)}\s*=", l) for l in lines[start + 1:end]):
                continue
            while end > start + 1 and not lines[end - 1].strip():
                end -= 1  # after the section's last line, before its trailing blanks
            lines.insert(end, f"{key} = {value}")
        added.append((section, key, value))
    if not added:
        sys.exit(0)
    text = "\n".join(lines) + "\n"
    if toml:
        result = tomllib.loads(text)  # raises, leaving the file untouched
        for section, key, _ in added:
            if lookup(result, section, key) is None:
                raise ValueError(f"{key} would land outside [{section}]")
    try:
        mode = os.stat(path).st_mode & 0o777
    except FileNotFoundError:
        mode = 0o644
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=os.path.basename(path) + ".", suffix=".tmp")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)
    os.replace(tmp, path)
    tmp = None
except Exception as e:
    if tmp:
        os.unlink(tmp)
    print(f"[seed-emulators] {path}: {e}", file=sys.stderr)
    sys.exit(1)
print(f"[seed-emulators] {path}: set " + " ".join(f"{s}/{k}={v}" for s, k, v in added))
PY
  if [[ -f "$1" ]]; then chown abc:abc "$1"; fi
}

# PS1 BIOS for standalone DuckStation and RetroArch's SwanStation core. Without
# one, DuckStation exits 0 on launch and the player sees a black screen.
for f in scph5500 scph5501 scph5502 scph7001; do
  seed "$BIOS/ps/$f.bin" "/config/.local/share/duckstation/bios/$f.bin"
  seed "$BIOS/ps/$f.bin" "/config/.config/retroarch/system/$f.bin"
done

# Dreamcast BIOS pair for standalone Flycast and RetroArch's Flycast core.
# dc_flash.bin is written by the emulator, hence copy-if-missing.
for f in dc_boot dc_flash; do
  seed "$BIOS/dc/$f.bin" "/config/.local/share/flycast/$f.bin"
  seed "$BIOS/dc/$f.bin" "/config/.config/retroarch/system/dc/$f.bin"
done

# PS2 BIOS for PCSX2, whose data root is $XDG_CONFIG_HOME/PCSX2 (BIOS folder
# bios/). Pin the USA SCPH-39001 image, as the library's PS2 games are USA.
# A fresh PCSX2.ini starts the way the broker seeds one (SettingsVersion = 1),
# so PCSX2 keeps it rather than resetting to defaults.
for f in "$BIOS"/ps2/*; do
  seed "$f" "/config/.config/PCSX2/bios/${f##*/}"
done
PCSX2_INI=/config/.config/PCSX2/inis/PCSX2.ini
if ! grep -q '^BIOS = ' "$PCSX2_INI" 2>/dev/null; then
  mkdir_abc "${PCSX2_INI%/*}"
  [[ -f "$PCSX2_INI" ]] || printf '[UI]\nSettingsVersion = 1\n' >"$PCSX2_INI"
  if grep -q '^\[Filenames\]' "$PCSX2_INI"; then
    sed -i '/^\[Filenames\]/a BIOS = SCPH-39001.bin' "$PCSX2_INI"
  else
    printf '\n[Filenames]\nBIOS = SCPH-39001.bin\n' >>"$PCSX2_INI"
  fi
  chown abc:abc "$PCSX2_INI"
  echo "[seed-emulators] pinned PCSX2 BIOS SCPH-39001.bin"
fi
# PCSX2 pacing. The stream is captured on a 60.000 Hz timer (locked by
# SELKIES_FRAMERATE in compose), and PCSX2's defaults (VSync off, its own 59.94 Hz
# limiter) drift against it, repeating or dropping a frame every ~17 s. Sync to the
# host refresh and pace on VSync instead. VSync then sets game speed, which is why
# the capture rate must stay locked: at 30 fps PCSX2 would run at half speed.
# MTVU (VU1 on its own thread) is PCSX2's own default on 3+ cores, but PCSX2 sets
# it only when it writes a fresh ini itself, and the BIOS pin above writes one first.
set_defaults "$PCSX2_INI" \
  EmuCore/GS VsyncEnable true \
  EmuCore/GS SyncToHostRefreshRate true \
  EmuCore/GS UseVSyncForTiming true \
  EmuCore/Speedhacks vuThread true

# Wii controls. The broker binds GameCube pads to the virtual SDL pad but leaves
# Wiimotes on Dolphin's keyboard/mouse default. Emulate a Wiimote with a Classic
# Controller on each SDL pad, which covers Classic-capable games (Xenoblade).
DOLPHIN_CFG=/config/.config/dolphin-emu
if ! grep -q 'SDL/' "$DOLPHIN_CFG/WiimoteNew.ini" 2>/dev/null; then
  mkdir_abc "$DOLPHIN_CFG"
  install -m 0644 -o abc -g abc /seed/dolphin-WiimoteNew.ini "$DOLPHIN_CFG/WiimoteNew.ini" &&
    echo "[seed-emulators] installed Wii Classic Controller map"
fi

# Dolphin graphics. GFX.ini starts empty, so Dolphin compiles each new shader
# synchronously and the game hitches the first time an effect appears (worst on a
# cold cache, e.g. instances 2 and 3). Hybrid ubershaders (mode 2) draw with an
# ubershader while the specialized one compiles in the background. 3 background
# compile threads for the ubershaders: auto would start 10, sized from jf's 12 vCPUs,
# not the 4 in the cpuset. WaitForShadersBeforeStarting stays off: on a cold cache it
# would hold the game past the broker's fixed 5 s delay before it loads a resume state.
# VSync on, with duplicate frames still presented, puts frames on the compositor's
# 60 Hz ticks instead of wherever Dolphin's own timer lands them. Dolphin can't sync
# to the host rate, so one repeated frame per ~17 s remains (59.94 vs 60). GFX.ini,
# not Dolphin.ini: the image's autostart can rewrite Dolphin.ini.
set_defaults "$DOLPHIN_CFG/GFX.ini" \
  Settings ShaderCompilationMode 2 \
  Settings ShaderPrecompilerThreads 3 \
  Hardware VSync True \
  Hacks SkipDuplicateXFBs False

# PCSX2 patch bundle (GameDB fixes, widescreen, no-interlace). pcsx2-qt reads it
# only from /usr/share/PCSX2/resources/patches.zip, which this image doesn't ship,
# and the broker's own refresh installs it with sudo, which DISABLE_SUDO blocks
# (compose turns that refresh off with PCSX2_PATCHES_FETCH=false). Fetch
# upstream's rolling release here instead, as root, when missing or a week old.
# It lives in the container layer, so a recreate fetches it again.
PATCHES=/usr/share/PCSX2/resources/patches.zip
if [[ ! -f "$PATCHES" || -n "$(find "$PATCHES" -mtime +7 2>/dev/null)" ]]; then
  tmp="$(mktemp)"
  if curl -fsSL --max-time 60 --max-filesize 67108864 -o "$tmp" \
      https://github.com/PCSX2/pcsx2_patches/releases/download/latest/patches.zip &&
    python3 - "$tmp" <<'PY'
import sys, zipfile
with zipfile.ZipFile(sys.argv[1]) as z:  # a 200 can still carry an error page
    ok = z.testzip() is None and any(n.endswith(".pnach") for n in z.namelist())
sys.exit(0 if ok else 1)
PY
  then
    install -D -m 0644 -o root -g root "$tmp" "$PATCHES" && echo "[seed-emulators] installed PCSX2 patches.zip"
  else
    echo "[seed-emulators] PCSX2 patches.zip fetch failed; PCSX2 runs without patches"
  fi
  rm -f "$tmp"
fi

# Xbox (xemu). The broker reads hdd_path from xemu.toml and pins only the renderer
# and fullscreen, so the boot ROM, flash BIOS, EEPROM and HDD are ours to set.
# Complex 4627 is the flash image proven to boot Halo on jf. The HDD is xemu's
# official blank image (xemu-hdd-image 1.0); the broker converts it to raw in
# place on first launch so it can reach saves through FATX. xemu creates the
# EEPROM itself. Port 1 is bound to the virtual pad's SDL GUID,
# 030081b85e0400008e02000014010000 (what the container's SDL 2.32.10 reports).
XEMU_DIR=/config/xemu
XEMU_TOML=/config/.local/share/xemu/xemu/xemu.toml
mkdir_abc "$XEMU_DIR"
# xemu's config dirs once came up root-owned 0700 (holding an empty xemu.toml),
# which abc can't read: xemu then aborts in xemu_settings_get_base_path().
[[ -d /config/.local/share/xemu ]] && chown -R abc:abc /config/.local/share/xemu
if [[ ! -e "$XEMU_DIR/xbox_hdd.qcow2" ]]; then
  python3 - /seed/xemu-xbox_hdd.qcow2.zip "$XEMU_DIR" <<'PY' &&
import sys, zipfile
with zipfile.ZipFile(sys.argv[1]) as z:
    z.extract("xbox_hdd.qcow2", sys.argv[2])
PY
    chown abc:abc "$XEMU_DIR/xbox_hdd.qcow2" && echo "[seed-emulators] installed blank Xbox HDD"
fi
# Missing or empty: on jf an empty, root-owned xemu.toml appeared before xemu
# ever ran, and an existence check left it unconfigured.
if [[ ! -s "$XEMU_TOML" ]]; then
  mkdir_abc "${XEMU_TOML%/*}"
  cat >"$XEMU_TOML" <<'TOML'
[general]
show_welcome = false
skip_boot_anim = true

[display.quality]
surface_scale = 2

[input.bindings]
port1 = '030081b85e0400008e02000014010000'

[sys.files]
bootrom_path = '/romm/library/bios/xbox/mcpx_1.0.bin'
flashrom_path = '/romm/library/bios/xbox/Complex_4627.bin'
eeprom_path = '/config/xemu/eeprom.bin'
hdd_path = '/config/xemu/xbox_hdd.qcow2'
TOML
  chown abc:abc "$XEMU_TOML"
  echo "[seed-emulators] wrote xemu.toml"
elif ! grep -q '^bootrom_path' "$XEMU_TOML"; then
  echo "[seed-emulators] $XEMU_TOML exists without [sys.files]; left alone"
fi
# xemu's audio voice workers. Auto (0) starts one per CPU it sees, which is all 12
# of jf's vCPUs, not the 4 in the cpuset. The 12 threads woke ~22,000 times/s and
# kept the container's cpu.pressure at 11-15% with its vCPUs about half idle; fewer
# workers leave that CPU to Selkies and labwc. It won't raise xemu's own ceiling: an
# exclusive vCPU for the emulated-CPU thread made no felt difference (2026-10-12).
# Never 1, so the voice processor stays parallel; if audio crackles (Debug > Audio
# utilization at 1 or more), raise it to 4. Auto can't be restored from xemu's menu:
# xemu drops default-valued keys on exit and this puts 3 back, so change it here.
set_defaults "$XEMU_TOML" audio.vp num_workers 3

# PPSSPP controls. The broker writes controls.ini with only its Save/Load State
# keys, and PPSSPP 1.20 (KeyMap::LoadFromIni) drops the default binding of every
# action a [ControlMapping] section leaves out: no keyboard, no pad. Install the
# full default map; the broker then merges its bracket keys into it.
PPSSPP_SYS=/config/.config/ppsspp/PSP/SYSTEM
if ! grep -q '^Up = ' "$PPSSPP_SYS/controls.ini" 2>/dev/null; then
  mkdir_abc "$PPSSPP_SYS"
  install -m 0644 -o abc -g abc /seed/ppsspp-controls.ini "$PPSSPP_SYS/controls.ini" &&
    echo "[seed-emulators] installed full PPSSPP control map"
fi

# PPSSPP memory stick: report 1 GB. Bigger sticks overflow the signed 32-bit
# free-space math some games do ("not enough space" in Sonic Rivals 2).
INI="$PPSSPP_SYS/ppsspp.ini"
if ! grep -q '^MemStickSize' "$INI" 2>/dev/null; then
  mkdir_abc "$PPSSPP_SYS"
  touch "$INI"
  if grep -q '^\[SystemParam\]' "$INI"; then
    sed -i '/^\[SystemParam\]/a MemStickSize = 1' "$INI"
  else
    printf '\n[SystemParam]\nMemStickSize = 1\n' >>"$INI"
  fi
  chown abc:abc "$INI"
  echo "[seed-emulators] set PPSSPP MemStickSize = 1"
fi

# RetroArch's controller profiles and menu assets. The broker's retroarch.cfg points
# joypad_autoconfig_dir at ~/.config/retroarch/autoconfig, but nothing fills it on a
# fresh /config. Without the profiles RetroArch shows "Microsoft X-Box 360 pad (0/0)
# not configured" for Selkies' virtual pads and ignores them (found 2026-10-25 on the
# Forge and on jf's instances 2 and 3; instance 1 had them from its first setup). The
# image ships both under /usr/share/libretro: copy whatever is missing, as abc.
for ra_dir in autoconfig assets; do
  [[ -d "/usr/share/libretro/$ra_dir" ]] || continue
  if [[ -z "$(ls -A "/config/.config/retroarch/$ra_dir" 2>/dev/null)" ]]; then
    mkdir_abc "/config/.config/retroarch/$ra_dir"
    s6-setuidgid abc cp -r --update=none "/usr/share/libretro/$ra_dir/." "/config/.config/retroarch/$ra_dir/" \
      && echo "[seed-emulators] seeded RetroArch $ra_dir from the image"
  fi
done

# Selkies page scripts, loaded from index.html ahead of the client's own bundle. The
# web root sits in the container layer, so this runs on every start.
# - gamepad-shim.js: Chrome gives some controllers no standard layout, and for those
#   the Selkies client turns raw axes 4/5 into the d-pad and ignores hats: a PowerA
#   GameCube-style pad loses its d-pad and its C-stick drives it instead. The shim
#   rewrites known pads to the standard layout before the client reads them, so
#   Dolphin's GameCube map (and every other emulator's) sees an Xbox-layout pad.
# - video-sink.js: in Chromium browsers the client decodes on the page and feeds a
#   MediaStreamTrackGenerator -> <video>, and streams froze there for about a second
#   at a time. Hiding the generator makes Chromium decode and draw in the client's
#   video worker, the path Firefox takes.
# - playout-buffer.js: the worker draws each frame the moment it's decoded, so bunched
#   arrivals show as hitches. It holds frames ~50 ms and draws them on the display's
#   refresh at a steady cadence (homelab.playoutMs in localStorage tunes it; 0 = off).
SELKIES_WEB=/usr/share/selkies/web
if [[ -f "$SELKIES_WEB/index.html" ]]; then
  for page_js in gamepad-shim video-sink playout-buffer; do
    install -m 0644 -o root -g root "/seed/selkies-$page_js.js" "$SELKIES_WEB/$page_js.js" || continue
    if ! grep -q "$page_js.js" "$SELKIES_WEB/index.html"; then
      sed -i "s|<head>|<head><script src=\"./$page_js.js\"></script>|" "$SELKIES_WEB/index.html"
      if grep -q "$page_js.js" "$SELKIES_WEB/index.html"; then
        echo "[seed-emulators] loaded $page_js.js into the Selkies page"
      else
        echo "[seed-emulators] Selkies index.html has no <head>; $page_js.js not loaded"
      fi
    fi
  done
fi
