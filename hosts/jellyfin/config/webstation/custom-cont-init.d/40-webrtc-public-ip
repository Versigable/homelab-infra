#!/usr/bin/with-contenv bash
# Runs as root on every container start (LinuxServer custom-cont-init.d).
# WebRTC (UDP) transport: hands Selkies the public address for its ICE candidate.
#
# SELKIES_WEBRTC_PUBLIC_IP takes an IP address only (Selkies parses it with
# ipaddress.ip_address), but X-Mansion's WAN IP is dynamic: the DDNS record
# games-udp.ninjaprivacy.org tracks it, and webstation-udp.ninjaprivacy.org is a
# DNS-only CNAME to it. An instance in WebRTC mode names that host in
# WEBRTC_PUBLIC_HOST, and this resolves it here, before svc-selkies starts. If the
# WAN IP changes, restart the instance.
#
# If the host doesn't resolve to a usable public IPv4 (missing record, a proxied
# record answering with Cloudflare's IPs, DNS down at boot), the instance falls back
# to websockets mode: it still streams over TCP instead of advertising an address
# players can't reach. Instances in websockets mode skip this script.

[[ "${SELKIES_MODE:-websockets}" == webrtc ]] || exit 0

ENVDIR=/run/s6/container_environment
fallback() {
  echo "[webrtc-public-ip] $*; falling back to websockets mode"
  printf 'websockets' > "${ENVDIR}/SELKIES_MODE"
  exit 0
}

host="${WEBRTC_PUBLIC_HOST:-}"
[[ -n "$host" ]] || fallback "WEBRTC_PUBLIC_HOST is not set"

# Prints the address on stdout, or a reason on stderr with a non-zero exit.
resolve() {
  /lsiopy/bin/python3 -I - "$1" <<'PY'
import ipaddress, socket, sys
# Cloudflare's proxy ranges (https://www.cloudflare.com/ips-v4): an orange-cloud
# record resolves into these, and Cloudflare doesn't carry this UDP.
CLOUDFLARE = ["173.245.48.0/20", "103.21.244.0/22", "103.22.200.0/22", "103.31.4.0/22",
              "141.101.64.0/18", "108.162.192.0/18", "190.93.240.0/20", "188.114.96.0/20",
              "197.234.240.0/22", "198.41.128.0/17", "162.158.0.0/15", "104.16.0.0/13",
              "104.24.0.0/14", "172.64.0.0/13", "131.0.72.0/22"]
try:
    addr = ipaddress.ip_address(socket.getaddrinfo(sys.argv[1], None, socket.AF_INET)[0][4][0])
except Exception as e:
    sys.exit(f"{sys.argv[1]} did not resolve ({e})")
if not addr.is_global:
    sys.exit(f"{sys.argv[1]} resolved to a non-public address")
if any(addr in ipaddress.ip_network(n) for n in CLOUDFLARE):
    sys.exit(f"{sys.argv[1]} resolved to a Cloudflare proxy address (the record must be DNS-only)")
print(addr)
PY
}

ip=""
for attempt in 1 2 3 4 5; do
  if ip="$(resolve "$host")"; then
    break
  fi
  ip=""
  sleep 2
done
[[ -n "$ip" ]] || fallback "no public IPv4 for ${host} after 5 tries"

printf '%s' "$ip" > "${ENVDIR}/SELKIES_WEBRTC_PUBLIC_IP"
echo "[webrtc-public-ip] WebRTC host candidate address set from ${host}"
