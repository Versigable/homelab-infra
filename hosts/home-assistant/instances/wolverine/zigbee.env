# Zigbee2MQTT settings for this house (not secret). Zigbee2MQTT stays off until
# ZIGBEE_COORDINATOR and ZIGBEE_CHANNEL are both set. deploy.sh puts these into
# Zigbee2MQTT's configuration.yaml on its first start only; changing them afterwards
# means editing the live file, and for the channel or the PAN IDs, re-pairing everything.
# The network key is a secret: ZIGBEE_NETWORK_KEY in secrets/wolverine.env.sops.

# The SLZB-MR1's Zigbee radio on LAB (wolverine-sw1 Gi1/0/2), as host:port (Zigbee is on
# 7638). Empty until the radio is installed and has its LAB address.
ZIGBEE_COORDINATOR=
# 15, 20 or 25 (clear of the Wi-Fi channels). Choose before pairing anything.
ZIGBEE_CHANNEL=

# Generated 2026-10-25 and fixed here, so a rebuild comes back on the network the
# radio remembers. Different from X-Mansion's on purpose: they are separate networks.
ZIGBEE_PAN_ID=0x6982
ZIGBEE_EXT_PAN_ID=[58, 239, 158, 186, 50, 43, 97, 95]
