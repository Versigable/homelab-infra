global:
  resolve_timeout: 5m

route:
  receiver: discord
  group_by: ['alertname', 'cluster', 'service']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Critical alerts ALSO go to the phone through ntfy (topic `urgent`, which
    # the phone lets through Do Not Disturb). `continue: true` plus the
    # catch-all below keep every alert going to Discord exactly as before.
    - receiver: ntfy-urgent
      matchers: ['severity="critical"']
      continue: true
    - receiver: discord

receivers:
  - name: discord
    # Discord exposes a Slack-compatible webhook variant — append /slack to the
    # webhook URL and Alertmanager's slack_configs receiver works directly.
    # The ${DISCORD_WEBHOOK_URL} placeholder is rendered at deploy time by
    # envsubst (see hosts/monitoring/scripts/deploy.sh).
    slack_configs:
      - api_url: '${DISCORD_WEBHOOK_URL}/slack'
        channel: '#homelab-alerts'
        send_resolved: true
        title: '{{ if eq .Status "firing" }}🔥 [FIRING]{{ else }}✅ [RESOLVED]{{ end }} {{ .GroupLabels.alertname }}'
        text: |-
          {{ range .Alerts -}}
          *{{ .Annotations.summary }}*
          {{ .Annotations.description }}
          {{ if .Labels.instance }}Instance: `{{ .Labels.instance }}`{{ end }}
          {{- if .Labels.severity }} | Severity: `{{ .Labels.severity }}`{{ end }}
          {{ end }}

  - name: ntfy-urgent
    # ntfy's built-in `alertmanager` template formats the webhook payload.
    # Posted over monitoring-net, so there is no Cloudflare hop. The token is
    # write-only to `urgent` and rendered by envsubst from ntfy.env.sops.
    # Resolved notices stay Discord-only, so a fix at 3 a.m. doesn't buzz
    # through DND.
    webhook_configs:
      - url: 'http://ntfy:2586/urgent?template=alertmanager&priority=urgent&tags=rotating_light'
        send_resolved: false
        http_config:
          authorization:
            type: Bearer
            credentials: '${NTFY_ALERTMANAGER_TOKEN}'
