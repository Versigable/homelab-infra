#jinja2: lstrip_blocks: True
# Managed by Ansible (role iac_runner). The studio's secrets, under the names roles/studio_cell
# reads; the iac-studio CI jobs point GITLAB_TOKEN_FILE here and iac.sh exports them.
{% set old = (iac_runner_env_old.content | default('') | b64decode).splitlines() %}
{% for h in groups['studio_cell'] | default([]) | sort %}
  {% set owner = hostvars[h].studio_cell_owner | upper | replace('-', '_') %}
  {% for p in iac_runner_studio_secrets %}
    {% set name = p.prefix ~ owner ~ p.suffix %}
    {% set kept = (old | select('match', name ~ '=') | first | default(name ~ '=')).split('=', 1)[1] %}
    {% set value = lookup('ansible.builtin.env', name) or kept %}
    {% if value %}
{{ name }}={{ value }}
    {% endif %}
  {% endfor %}
{% endfor %}
