#!/usr/bin/python3 -I
"""Managed by Ansible (role studio_gw): studio-gw-publish-names.

Looks up each name in studio_gw_published_names with the gateway's own (LAN) resolver
and publishes its address to the studio network as <name>.studio: one hosts file per
name in {{ studio_gw_hostsdir }}, which dnsmasq re-reads when it changes. The studio
network itself still has no upstream resolver.

Only a public IPv4 that isn't one of Cloudflare's proxy addresses is published (a
proxied record, or a missing name caught by a proxied wildcard, answers with those).
A failed or refused lookup keeps the last published address and exits 1, so the
timer's unit shows the failure in the journal.
"""
import ipaddress
import os
import socket
import sys
import tempfile

HOSTSDIR = {{ studio_gw_hostsdir | to_json }}
NAMES = {{ studio_gw_published_names | to_json }}
# https://www.cloudflare.com/ips-v4
CLOUDFLARE = ["173.245.48.0/20", "103.21.244.0/22", "103.22.200.0/22", "103.31.4.0/22",
              "141.101.64.0/18", "108.162.192.0/18", "190.93.240.0/20", "188.114.96.0/20",
              "197.234.240.0/22", "198.41.128.0/17", "162.158.0.0/15", "104.16.0.0/13",
              "104.24.0.0/14", "172.64.0.0/13", "131.0.72.0/22"]


def lookup(name: str) -> str:
    addr = ipaddress.ip_address(socket.getaddrinfo(name, None, socket.AF_INET)[0][4][0])
    if not addr.is_global:
        raise ValueError("not a public address")
    if any(addr in ipaddress.ip_network(n) for n in CLOUDFLARE):
        raise ValueError("a Cloudflare proxy address (the record must be DNS-only)")
    return str(addr)


failed = False
for entry in NAMES:
    path = os.path.join(HOSTSDIR, entry["name"])
    try:
        addr = lookup(entry["lookup"])
    except Exception as e:
        print(f"{entry['lookup']}: {e}; keeping the last published address", file=sys.stderr)
        failed = True
        continue
    line = f"{addr} {entry['name']}.studio\n"
    try:
        with open(path) as f:
            if f.read() == line:
                continue
    except FileNotFoundError:
        pass
    # Written beside the hostsdir, then renamed in, so dnsmasq never reads half a file.
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(HOSTSDIR), prefix="studio-gw-publish-")
    with os.fdopen(fd, "w") as f:
        f.write(line)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
    print(f"{entry['name']}.studio updated from {entry['lookup']}")
sys.exit(1 if failed else 0)
