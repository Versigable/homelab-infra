#!/usr/sbin/nft -f
# Managed by Ansible (role studio_gw). The studio network's policy. Guests reach the outside
# through Squid on this host (HTTP(S) by name); the only traffic forwarded out goes to the LAN
# services in studio_gw_lan_access, by address and port, source-NATed to this host. Inbound,
# only the listed callers are forwarded in (DNAT). Edit inventory/group_vars/studio_gw.yml,
# not this.
flush ruleset

define LAN = "{{ studio_gw_lan_if }}"
define STUDIO = "{{ studio_gw_studio_if }}"

table inet studio_gw {
	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iif lo accept
		meta l4proto icmp accept
		iifname $LAN ip saddr {{ studio_gw_admin_net }} tcp dport 22 accept
		iifname $STUDIO ip saddr {{ studio_gw_studio_net }} tcp dport {{ studio_gw_proxy_port }} accept
		iifname $STUDIO ip saddr {{ studio_gw_studio_net }} meta l4proto { tcp, udp } th dport 53 accept
		iifname $STUDIO ip saddr {{ studio_gw_studio_net }} udp dport 123 accept
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
{% for r in studio_gw_ingress %}
		# {{ r.name }}: {{ r.from }} -> {{ studio_gw_lan_ip }}:{{ r.port }} -> {{ r.to_ip }}:{{ r.to_port }}
		iifname $LAN oifname $STUDIO ip saddr {{ r.from }} ip daddr {{ r.to_ip }} tcp dport {{ r.to_port }} ct status dnat accept
{% endfor %}
{% for r in studio_gw_lan_access %}
		# {{ r.name }}: {{ r.from }} -> {{ r.to_ip }}:{{ r.port }}, as {{ studio_gw_lan_ip }}
		iifname $STUDIO oifname $LAN ip saddr {{ r.from }} ip daddr {{ r.to_ip }} tcp dport {{ r.port }} accept
{% endfor %}
	}

	chain prerouting {
		type nat hook prerouting priority dstnat;
{% for r in studio_gw_ingress %}
		iifname $LAN ip saddr {{ r.from }} ip daddr {{ studio_gw_lan_ip }} tcp dport {{ r.port }} dnat ip to {{ r.to_ip }}:{{ r.to_port }}
{% endfor %}
	}

	chain postrouting {
		type nat hook postrouting priority srcnat;
{% for r in studio_gw_lan_access %}
		oifname $LAN ip saddr {{ r.from }} ip daddr {{ r.to_ip }} tcp dport {{ r.port }} snat ip to {{ studio_gw_lan_ip }}
{% endfor %}
	}
}
