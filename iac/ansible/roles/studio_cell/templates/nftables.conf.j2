#!/usr/sbin/nft -f
# Managed by Ansible (role studio_cell). Egress per user on a studio cell.
#
# A cell has the internet directly through studio-gw, which never forwards it to the LAN, the
# tailnet or SMTP. Out, per user:
# - each user in studio_cell_user_proxy_ports reaches only its own port on studio-gw's Squid,
#   which tells a cell's users apart by that port: unity Unity's class, nothing else;
# - each user in studio_cell_internet_users (agent) reaches the internet, but nothing private
#   (studio_cell_private_nets): not studio0's hub, Squid or other cells, nor the LAN;
# - loopback is open to both, except the ports in studio_cell_loopback_deny.
# Their other traffic is refused at once (TCP reset), not left to time out. Everyone else,
# root and the owner included, is unrestricted here. This host has no Docker or other rule
# owner, so the whole ruleset is ours.
#
# In: only the owner's browser terminal (studio-term) is filtered. Its port is taken from
# Traefik's address only (through studio-gw, after Authentik and the hub's owner check), never
# from another guest on studio0, another person's cell, or this cell's own users over loopback.
flush ruleset

table inet studio_cell {
	chain input {
		type filter hook input priority filter; policy accept;
		tcp dport {{ studio_cell_term_port }} ip saddr {{ studio_cell_term_from }} accept
		# everything else on that port, IPv4 and IPv6 (ttyd listens on both; ::1 too)
		tcp dport {{ studio_cell_term_port }} counter reject with tcp reset
	}

	chain output {
		type filter hook output priority filter; policy accept;
{% for user, port in studio_cell_user_proxy_ports | dictsort %}
		meta skuid "{{ user }}" jump only_{{ user }}
{% endfor %}
{% for user in studio_cell_internet_users | sort %}
		meta skuid "{{ user }}" jump internet_{{ user }}
{% endfor %}
	}
{% for user, port in studio_cell_user_proxy_ports | dictsort %}
{% set deny = studio_cell_loopback_deny[user] | default([]) %}

	# {{ user }}: Squid's :{{ port }} on studio-gw, and loopback{{ (' except ' ~ (deny | join(', '))) if deny else '' }}; nothing else.
	chain only_{{ user }} {
		ct state established,related accept
		ip daddr {{ studio_cell_proxy_host }} tcp dport {{ port }} accept
{% if deny %}
		oif "lo" tcp dport { {{ deny | join(', ') }} } counter reject with tcp reset
{% endif %}
		oif "lo" accept
		meta l4proto tcp counter reject with tcp reset
		counter reject with icmpx admin-prohibited
	}
{% endfor %}
{% for user in studio_cell_internet_users | sort %}
{% set deny = studio_cell_loopback_deny[user] | default([]) %}

	# {{ user }}: the internet through studio-gw, and loopback{{ (' except ' ~ (deny | join(', '))) if deny else '' }}; nothing private.
	chain internet_{{ user }} {
		ct state established,related accept
{% if deny %}
		oif "lo" tcp dport { {{ deny | join(', ') }} } counter reject with tcp reset
{% endif %}
		oif "lo" accept
		ip daddr { {{ studio_cell_private_nets | join(', ') }} } meta l4proto tcp counter reject with tcp reset
		ip daddr { {{ studio_cell_private_nets | join(', ') }} } counter reject with icmpx admin-prohibited
		# studio0 has no IPv6 way out: only its link-local neighbours, the other guests
		meta nfproto ipv6 counter reject with icmpx admin-prohibited
		accept
	}
{% endfor %}
}
