#!/usr/bin/python3 -IB
# studio-desk-mcp (iac/studio/runtime): the desk's tools for Claude in a Slack turn, as a stdio
# MCP server. It runs as desk (Claude starts it) and holds nothing: each call goes to
# studio-slackd over /run/studio/desk.sock, which answers only desk inside the running turn.
# Isolated mode: no environment steers what runs.
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from studio_runtime.slackd import mcp_main  # noqa: E402

sys.exit(mcp_main())
