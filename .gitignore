# plaintext secrets (never commit)
*.dec
*.decrypted
*.plain
**/.env
**/.env.*
**/secrets/*.env
**/secrets/*.json
**/secrets/*.yaml
**/secrets/*.yml

hosts/**/secrets/*

# allow encrypted secrets (we’ll use .sops.* or .enc.* names)
!**/secrets/*.sops.*
!**/secrets/*.enc.*

!hosts/**/secrets/*.sops
!hosts/**/secrets/*.sops.*
!*/*.sops

# Claude Code local settings
.claude/

# iac/: Terraform working files and the generated Ansible guest inventory
iac/**/.terraform/
iac/**/*.tfstate
iac/**/*.tfstate.*
iac/**/*.tfplan
iac/ansible/inventory/guests.yml
iac/ansible/inventory/guests-*.yml
