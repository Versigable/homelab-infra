#!/usr/bin/env python3
"""labsecret: use lab secrets from Bitwarden's "Lab: admin" collection without printing them.

Made for agents (and humans) that must never see secret values on screen or in logs.
Values only ever go to 0600 files, or to the environment of one command.

  labsecret list                                  item names in the collection
  labsecret fields <item>                         field names of one item (no values)
  labsecret get <item>[#field] [--out PATH]       write the value to a 0600 file, print the path
  labsecret run [-e VAR=<item>[#field]]...        run one command with secrets in its env
                [-f VAR=<item>[#field]]...          -f: write to a 0600 temp file, set VAR=<path>
                [-E VAR=<item>]...                  -E: all hidden fields as KEY=value lines in a
                -- <command> [args...]                  0600 temp file, set VAR=<path> (env-file items)
  labsecret put <item>[#field] --from-file PATH   create or update an item from a file
                [--notes TEXT]

Fields: logins default to the password, secure notes to their only custom field
(or "value"). Name others with "#": "Jellyfin admin#username", "Some item#notes".

Config (environment):
  LABSECRET_DIR         key files dir (default ~/.config/bw-fk): client_id, client_secret,
                        master (0600), server.crt (pinned self-signed cert, optional)
  LABSECRET_COLLECTION  collection name (default "Lab: admin")
  LABSECRET_BW          bw binary (default: bw on PATH, then ~/.local/bin/bw)

The bw session key lives only in this process; the vault is locked again before
any command runs. Runs are serialised with a lock file, since `bw lock` ends every
session of this CLI profile.
"""
import argparse
import fcntl
import json
import os
import shutil
import subprocess
import sys
import tempfile

HOME = os.path.expanduser("~")
CFG = os.environ.get("LABSECRET_DIR", f"{HOME}/.config/bw-fk")
COLLECTION = os.environ.get("LABSECRET_COLLECTION", "Lab: admin")
BW = os.environ.get("LABSECRET_BW") or shutil.which("bw") or f"{HOME}/.local/bin/bw"

LOGIN, NOTE = 1, 2
HIDDEN, TEXT = 1, 0


class Fail(Exception):
    pass


def die(msg, code=1):
    print(f"labsecret: {msg}", file=sys.stderr)
    sys.exit(code)


class Vault:
    """One unlocked bw session, kept in memory, locked again on exit."""

    def __init__(self):
        self.env = dict(os.environ)
        self.env.pop("BW_SESSION", None)
        crt = os.path.join(CFG, "server.crt")
        if os.path.exists(crt):
            self.env["NODE_EXTRA_CA_CERTS"] = crt
        self._lockf = None
        self.org = self.cid = None

    def bw(self, *args, stdin=None):
        r = subprocess.run([BW, "--nointeraction", *args], input=stdin,
                           capture_output=True, text=True, env=self.env)
        if r.returncode != 0:
            # bw error text holds no secret values, but keep it to one short line
            first = (r.stderr or r.stdout).strip().splitlines()[:1]
            raise Fail(f"bw {args[0]} failed: {first[0][:200] if first else 'exit %d' % r.returncode}")
        return r.stdout

    def __enter__(self):
        os.makedirs(CFG, exist_ok=True)
        self._lockf = open(os.path.join(CFG, "labsecret.lock"), "w")
        fcntl.flock(self._lockf, fcntl.LOCK_EX)
        for f in ("client_id", "client_secret", "master"):
            p = os.path.join(CFG, f)
            if not os.path.exists(p):
                raise Fail(f"missing {p}")
            if os.stat(p).st_mode & 0o077:
                raise Fail(f"{p} must be mode 0600")
        if json.loads(self.bw("status"))["status"] == "unauthenticated":
            self.env["BW_CLIENTID"] = _read(os.path.join(CFG, "client_id"))
            self.env["BW_CLIENTSECRET"] = _read(os.path.join(CFG, "client_secret"))
            try:
                self.bw("login", "--apikey")
            finally:
                self.env.pop("BW_CLIENTID", None)
                self.env.pop("BW_CLIENTSECRET", None)
        self.env["BW_SESSION"] = self.bw(
            "unlock", "--passwordfile", os.path.join(CFG, "master"), "--raw").strip()
        self.bw("sync")
        cols = [c for c in json.loads(self.bw("list", "collections")) if c["name"] == COLLECTION]
        if len(cols) != 1:
            raise Fail(f'expected one collection named "{COLLECTION}", found {len(cols)}')
        self.cid, self.org = cols[0]["id"], cols[0]["organizationId"]
        return self

    def __exit__(self, *exc):
        if "BW_SESSION" in self.env:
            try:
                self.bw("lock")
            except Fail:
                pass
            self.env.pop("BW_SESSION", None)
        if self._lockf:
            fcntl.flock(self._lockf, fcntl.LOCK_UN)
            self._lockf.close()
        return False

    def items(self):
        return json.loads(self.bw("list", "items", "--collectionid", self.cid))

    def item(self, name, missing_ok=False):
        found = [i for i in self.items() if i["name"] == name]
        if not found:
            if missing_ok:
                return None
            raise Fail(f'no item named "{name}" in "{COLLECTION}" (names are exact; see `labsecret list`)')
        if len(found) > 1:
            raise Fail(f'{len(found)} items named "{name}" in "{COLLECTION}"; rename one')
        it = found[0]
        if self.cid not in (it.get("collectionIds") or []):
            raise Fail(f'"{name}" is not in "{COLLECTION}"')
        return it


def _read(path):
    with open(path) as f:
        return f.read().strip()


def split_ref(ref):
    name, _, field = ref.partition("#")
    return name, (field or None)


def field_names(it):
    names = []
    if it["type"] == LOGIN:
        lg = it.get("login") or {}
        names += [k for k in ("username", "password", "totp") if lg.get(k)]
    names += [f["name"] for f in it.get("fields") or []]
    if it.get("notes"):
        names.append("notes")
    return names


def value_of(it, field):
    lg = it.get("login") or {}
    custom = {f["name"]: f.get("value") for f in it.get("fields") or []}
    if field is None:
        if it["type"] == LOGIN:
            field = "password"
        elif len(custom) == 1:
            field = next(iter(custom))
        elif "value" in custom:
            field = "value"
        else:
            raise Fail(f'"{it["name"]}" has fields {field_names(it)}; pick one with "#field"')
    if field in custom:
        v = custom[field]
    elif it["type"] == LOGIN and field in ("username", "password", "totp"):
        v = lg.get(field)
    elif field == "notes":
        v = it.get("notes")
    else:
        raise Fail(f'"{it["name"]}" has no field "{field}" (has {field_names(it)})')
    if v in (None, ""):
        raise Fail(f'"{it["name"]}#{field}" is empty')
    return v


def env_lines(it):
    hidden = [(f["name"], f.get("value") or "") for f in it.get("fields") or [] if f.get("type") == HIDDEN]
    if not hidden:
        raise Fail(f'"{it["name"]}" has no hidden fields to write as KEY=value')
    return "".join(f"{k}={v}\n" for k, v in hidden)


def write_secret(text, out=None):
    """Write text to a 0600 file (new temp file unless out is given) and return its path."""
    if out:
        fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        os.fchmod(fd, 0o600)
        path = out
    else:
        base = os.environ.get("XDG_RUNTIME_DIR") or ("/dev/shm" if os.path.isdir("/dev/shm") else None)
        fd, path = tempfile.mkstemp(prefix="labsecret-", dir=base)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    return path


def parse_binding(s, flag):
    var, sep, ref = s.partition("=")
    if not sep or not var or not ref or not var.replace("_", "").isalnum():
        die(f"{flag} wants VAR=<item>[#field], got: {s!r}", 2)
    return var, ref


def cmd_list(v, a):
    for name in sorted(i["name"] for i in v.items()):
        print(name)


def cmd_fields(v, a):
    for f in field_names(v.item(a.item)):
        print(f)


def cmd_get(v, a):
    name, field = split_ref(a.ref)
    print(write_secret(value_of(v.item(name), field), a.out))


def cmd_put(v, a):
    name, field = split_ref(a.ref)
    field = field or "value"
    with open(a.from_file) as f:
        val = f.read()
    if val.endswith("\n") and val.count("\n") == 1:
        val = val[:-1]
    it = v.item(name, missing_ok=True)
    if it is None:
        new = {"type": NOTE, "secureNote": {"type": 0}, "name": name, "notes": a.notes,
               "fields": [{"name": field, "value": val, "type": HIDDEN}],
               "organizationId": v.org, "collectionIds": [v.cid], "folderId": None, "favorite": False}
        enc = v.bw("encode", stdin=json.dumps(new)).strip()
        made = json.loads(v.bw("create", "item", stdin=enc))
        print(f'created "{name}" ({made["id"]})')
        return
    if it["type"] == LOGIN and field in ("username", "password"):
        it["login"][field] = val
    elif field == "notes":
        it["notes"] = val
    else:
        fields = it.get("fields") or []
        for f in fields:
            if f["name"] == field:
                f["value"] = val
                break
        else:
            fields.append({"name": field, "value": val, "type": HIDDEN})
        it["fields"] = fields
    if a.notes is not None and field != "notes":
        it["notes"] = a.notes
    enc = v.bw("encode", stdin=json.dumps(it)).strip()
    v.bw("edit", "item", it["id"], stdin=enc)
    print(f'updated "{name}#{field}" ({it["id"]})')


def cmd_run(a, argv_cmd):
    if not argv_cmd:
        die("run needs a command after --", 2)
    env, files = dict(os.environ), []
    try:
        with Vault() as v:
            for s in a.env or []:
                var, ref = parse_binding(s, "-e")
                env[var] = value_of(v.item(split_ref(ref)[0]), split_ref(ref)[1])
            for s in a.file or []:
                var, ref = parse_binding(s, "-f")
                p = write_secret(value_of(v.item(split_ref(ref)[0]), split_ref(ref)[1]))
                files.append(p)
                env[var] = p
            for s in a.envfile or []:
                var, ref = parse_binding(s, "-E")
                p = write_secret(env_lines(v.item(ref)))
                files.append(p)
                env[var] = p
        # vault is locked again here; only the child gets the values
        env.pop("BW_SESSION", None)
        try:
            return subprocess.run(argv_cmd, env=env).returncode
        except FileNotFoundError:
            die(f"command not found: {argv_cmd[0]}", 127)
    finally:
        for p in files:
            try:
                os.unlink(p)
            except FileNotFoundError:
                pass


def main():
    argv = sys.argv[1:]
    run_cmd = []
    if "--" in argv:
        i = argv.index("--")
        argv, run_cmd = argv[:i], argv[i + 1:]

    ap = argparse.ArgumentParser(prog="labsecret", description=__doc__.split("\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog="\n".join(__doc__.split("\n")[2:]))
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list")
    p = sub.add_parser("fields"); p.add_argument("item")
    p = sub.add_parser("get"); p.add_argument("ref"); p.add_argument("--out")
    p = sub.add_parser("put"); p.add_argument("ref")
    p.add_argument("--from-file", required=True); p.add_argument("--notes")
    p = sub.add_parser("run")
    p.add_argument("-e", "--env", action="append")
    p.add_argument("-f", "--file", action="append")
    p.add_argument("-E", "--envfile", action="append")
    a = ap.parse_args(argv)

    try:
        if a.cmd == "run":
            sys.exit(cmd_run(a, run_cmd))
        if run_cmd:
            die("'--' is only for run", 2)
        with Vault() as v:
            {"list": cmd_list, "fields": cmd_fields, "get": cmd_get, "put": cmd_put}[a.cmd](v, a)
    except Fail as e:
        die(str(e))


if __name__ == "__main__":
    main()
